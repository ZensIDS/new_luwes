# =====================================================================
#  Luwes — konfigurasi PC server lokal (Docker)
#  File ini disalin menjadi .env oleh "make init" (APP_KEY & password
#  database lokal dibuat otomatis). Yang WAJIB diisi manual: DB_SERVER_*.
#  Setelah mengubah .env jalankan: make restart
#  Nilai yang mengandung karakter $ # atau spasi: apit dengan tanda kutip tunggal '...'
# =====================================================================

APP_NAME=Luwes
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Ganti dengan IP PC server, mis. http://192.168.1.10
APP_URL=http://localhost
# Port web di PC server (PC client membuka http://IP-SERVER:APP_PORT, port 80 cukup http://IP-SERVER)
APP_PORT=80

LOG_CHANNEL=daily
LOG_LEVEL=warning

# --- Database LOKAL (container mysql, jangan ubah DB_HOST) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=luwes_kasir
DB_USERNAME=luwes
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Server lokal = id ganjil (offset 1). Hosting WAJIB offset 2.
DB_AUTO_INCREMENT_INCREMENT=2
DB_AUTO_INCREMENT_OFFSET=1

# --- Database HOSTING (tujuan sinkron) — WAJIB DIISI ---
DB_SERVER_CONNECTION=mysql
DB_SERVER_HOST=
DB_SERVER_PORT=3306
DB_SERVER_DATABASE=
DB_SERVER_USERNAME=
DB_SERVER_PASSWORD=

# --- Sinkron otomatis ---
DB_SYNC_ENABLED=true
# menit
DB_SYNC_INTERVAL=2
# skip = konflik dilewati + peringatan di dashboard; newest = otomatis pakai data terbaru
DB_SYNC_CONFLICT=skip

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=525600

# phpMyAdmin (opsional, "make pma")
PMA_PORT=8080
